# Copiar a .env en la raíz. No subir secretos a Git.
POSTGRES_USER=silva
POSTGRES_DB=silva
POSTGRES_PASSWORD=REPLACE_WITH_RANDOM_ALPHANUMERIC_SECRET
DATABASE_URL=postgresql://silva:REPLACE_WITH_RANDOM_ALPHANUMERIC_SECRET@db:5432/silva?schema=public
JWT_SECRET=REPLACE_WITH_AT_LEAST_48_RANDOM_CHARACTERS
CORS_ORIGIN=https://www.example.com
API_DOMAIN=api.example.com
BACKEND_IMAGE=ghcr.io/YOUR_ACCOUNT/distribuidora-silva-backend
IMAGE_TAG=initial
