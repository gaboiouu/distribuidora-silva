{
  "name": "@silva/backend",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.17.1 <23"
  },
  "scripts": {
    "setup": "node scripts/setup.mjs && prisma generate",
    "build": "prisma generate && tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "start:render": "prisma migrate deploy && node dist/main.js",
    "dev": "tsc -p tsconfig.build.json && node dist/main.js",
    "start:dev": "node scripts/run-env.mjs development start",
    "start:staging": "node scripts/run-env.mjs staging start",
    "start:production": "node scripts/run-env.mjs production start",
    "migrate:dev": "node scripts/run-env.mjs development migrate",
    "migrate:staging": "node scripts/run-env.mjs staging migrate",
    "migrate:production": "node scripts/run-env.mjs production migrate",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "user:create": "tsx src/auth/create-user.ts",
    "test": "jest --runInBand",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"test/**/*.ts\"",
    "user:create:prod": "node dist/auth/create-user.js"
  },
  "dependencies": {
    "@nestjs/common": "^11.0.0",
    "@nestjs/core": "^11.0.0",
    "@nestjs/platform-express": "^11.0.0",
    "@nestjs/jwt": "^11.0.0",
    "@nestjs/swagger": "^11.0.0",
    "@nestjs/throttler": "^6.4.0",
    "@prisma/client": "^6.19.0",
    "argon2": "^0.44.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.2",
    "dotenv": "^17.2.0",
    "helmet": "^8.1.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.0.0",
    "prisma": "^6.19.0"
  },
  "devDependencies": {
    "@nestjs/testing": "^11.0.0",
    "@types/express": "^5.0.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.0.0",
    "@types/supertest": "^6.0.0",
    "jest": "^30.0.0",
    "prettier": "^3.6.0",
    "supertest": "^7.1.0",
    "ts-jest": "^29.4.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  },
  "overrides": {
    "deepmerge-ts": "^8.0.0"
  }
}
