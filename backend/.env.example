NODE_ENV=development
APP_ENV=development
PORT=3000
# Neon: cadena POOLED (host con -pooler) para la app
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require
# Neon: cadena DIRECTA (sin -pooler) para migraciones
DIRECT_URL=postgresql://USER:PASSWORD@ep-xxxx.REGION.aws.neon.tech/neondb?sslmode=require
JWT_SECRET=REPLACE_WITH_AT_LEAST_48_RANDOM_CHARACTERS
# URL del frontend (Vercel); en local, Vite
CORS_ORIGIN=http://localhost:5173
# SUNAT / Nubefact (opcional hasta activar facturacion electronica)
BILLING_PROVIDER=DISABLED
NUBEFACT_API_URL=
NUBEFACT_TOKEN=
SUNAT_FACTURA_SERIE=F001
SUNAT_BOLETA_SERIE=B001
SUNAT_NC_FACTURA_SERIE=FC01
SUNAT_NC_BOLETA_SERIE=BC01
SUNAT_GUIA_SERIE=T001
