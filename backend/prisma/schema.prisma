generator client {
  provider = "prisma-client-js"
}
datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}
enum Role {
 ADMIN
 MEMBER
}
enum DeliveryStatus {
 PENDING
 DISPATCHED
 DELIVERED
 PICKED_UP
}
enum SaleStatus {
 ACTIVE
 CANCELLED
}
enum InvoiceType {
 FACTURA
 BOLETA
 NOTA_CREDITO
 GUIA_REMISION
}
enum SunatStatus {
 PENDING
 ACCEPTED
 OBSERVED
 REJECTED
 ERROR
}
enum IgvType {
 GRAVADO
 EXONERADO
 INAFECTO
}
model User {
 id String @id @default(uuid()) @db.Uuid
 email String @unique
 name String
 passwordHash String
 role Role @default(MEMBER)
 active Boolean @default(true)
 sessions Session[]
 createdAt DateTime @default(now())
}
model Session {
 id String @id @default(uuid()) @db.Uuid
 userId String @db.Uuid
 user User @relation(fields:[userId], references:[id])
 tokenHash String @unique
 expiresAt DateTime
 revokedAt DateTime?
 createdAt DateTime @default(now())
 @@index([userId])
}
model Product {
 id String @id @default(uuid()) @db.Uuid
 sku String @unique
 name String
 presentation String
 unitsPerBox Int
 price Decimal @db.Decimal(12,2)
 cost Decimal @db.Decimal(12,2)
 stock Int @default(0)
 active Boolean @default(true)
 published Boolean @default(false)
 movements StockMovement[]
 adjustments StockAdjustment[]
 saleItems SaleItem[]
 purchaseItems PurchaseItem[]
 boxProductId String? @db.Uuid
 boxesPerMaster Int?
 boxProduct Product? @relation("MasterBoxes", fields:[boxProductId], references:[id], onDelete: Restrict)
 masterProducts Product[] @relation("MasterBoxes")
 conversionsFrom StockConversion[] @relation("ConversionMaster")
 conversionsTo StockConversion[] @relation("ConversionBox")
 createdAt DateTime @default(now())
 @@index([boxProductId])
}
model StockAdjustment {
 id String @id @default(uuid()) @db.Uuid
 requestKey String @unique @db.Uuid
 productId String @db.Uuid
 product Product @relation(fields:[productId], references:[id])
 delta Int
 reason String
 notes String?
 createdBy String @db.Uuid
 createdAt DateTime @default(now())
 @@index([productId, createdAt])
}
model StockConversion {
 id String @id @default(uuid()) @db.Uuid
 requestKey String @unique @db.Uuid
 masterProductId String @db.Uuid
 masterProduct Product @relation("ConversionMaster", fields:[masterProductId], references:[id])
 boxProductId String @db.Uuid
 boxProduct Product @relation("ConversionBox", fields:[boxProductId], references:[id])
 masterQuantity Int
 boxesPerMaster Int
 boxQuantity Int
 unitCost Decimal @db.Decimal(12,2)
 createdBy String @db.Uuid
 createdAt DateTime @default(now())
 @@index([createdAt])
}
model Customer {
 id String @id @default(uuid()) @db.Uuid
 name String
 document String? @unique
 phone String?
 address String?
 sales Sale[]
 createdAt DateTime @default(now())
}
model Supplier {
 id String @id @default(uuid()) @db.Uuid
 name String
 document String? @unique
 phone String?
 purchases Purchase[]
}
model Sale {
 id String @id @default(uuid()) @db.Uuid
 requestKey String @unique @db.Uuid
 customerId String @db.Uuid
 customer Customer @relation(fields:[customerId], references:[id])
 total Decimal @db.Decimal(12,2)
 paid Decimal @default(0) @db.Decimal(12,2)
 dueAt DateTime?
 delivery DeliveryStatus @default(PENDING)
 status SaleStatus @default(ACTIVE)
 cancelledAt DateTime?
 cancelledBy String? @db.Uuid
 cancelReason String?
 createdBy String @db.Uuid
 items SaleItem[]
 payments Payment[]
 invoices Invoice[]
 returns SaleReturn[]
 createdAt DateTime @default(now())
 @@index([createdAt])
 @@index([customerId])
 @@index([status])
}
model SaleReturn {
 id String @id @default(uuid()) @db.Uuid
 requestKey String @unique @db.Uuid
 saleId String @db.Uuid
 sale Sale @relation(fields:[saleId], references:[id], onDelete: Restrict)
 reason String
 creditAmount Decimal @db.Decimal(12,2)
 refundAmount Decimal @db.Decimal(12,2)
 refundMethod String?
 items SaleReturnItem[]
 createdBy String @db.Uuid
 createdAt DateTime @default(now())
 @@index([saleId, createdAt])
}
model SaleReturnItem {
 id String @id @default(uuid()) @db.Uuid
 returnId String @db.Uuid
 saleReturn SaleReturn @relation(fields:[returnId], references:[id], onDelete: Restrict)
 productId String @db.Uuid
 quantity Int
 unitPrice Decimal @db.Decimal(12,2)
 unitCost Decimal @db.Decimal(12,2)
 @@unique([returnId, productId])
}
model SaleItem {
 id String @id @default(uuid()) @db.Uuid
 saleId String @db.Uuid
 sale Sale @relation(fields:[saleId], references:[id])
 productId String @db.Uuid
 product Product @relation(fields:[productId], references:[id])
 quantity Int
 unitPrice Decimal @db.Decimal(12,2)
 unitCost Decimal @db.Decimal(12,2)
}
model Payment {
 id String @id @default(uuid()) @db.Uuid
 requestKey String @unique @db.Uuid
 saleId String @db.Uuid
 sale Sale @relation(fields:[saleId], references:[id])
 amount Decimal @db.Decimal(12,2)
 method String
 createdBy String @db.Uuid
 createdAt DateTime @default(now())
}
model Purchase {
 id String @id @default(uuid()) @db.Uuid
 requestKey String @unique @db.Uuid
 supplierId String @db.Uuid
 supplier Supplier @relation(fields:[supplierId], references:[id])
 total Decimal @db.Decimal(12,2)
 paymentMethod String @default("CASH")
 cardName String?
 createdBy String @db.Uuid
 items PurchaseItem[]
 installments PurchaseInstallment[]
 purchasedAt DateTime @default(now())
 createdAt DateTime @default(now())
}
model PurchaseInstallment {
 id String @id @default(uuid()) @db.Uuid
 purchaseId String @db.Uuid
 purchase Purchase @relation(fields:[purchaseId], references:[id], onDelete: Restrict)
 number Int
 amount Decimal @db.Decimal(12,2)
 dueAt DateTime
 paidAt DateTime?
 @@unique([purchaseId, number])
 @@index([dueAt, paidAt])
}
model PurchaseItem {
 id String @id @default(uuid()) @db.Uuid
 purchaseId String @db.Uuid
 purchase Purchase @relation(fields:[purchaseId], references:[id])
 productId String @db.Uuid
 product Product @relation(fields:[productId], references:[id])
 quantity Int
 unitCost Decimal @db.Decimal(12,2)
}
model StockMovement {
 id String @id @default(uuid()) @db.Uuid
 productId String @db.Uuid
 product Product @relation(fields:[productId], references:[id])
 quantity Int
 reason String
 reference String?
 createdBy String @db.Uuid
 createdAt DateTime @default(now())
 @@index([productId, createdAt])
}
model Expense {
 id String @id @default(uuid()) @db.Uuid
 requestKey String @unique @db.Uuid
 description String
 amount Decimal @db.Decimal(12,2)
 createdBy String @db.Uuid
 createdAt DateTime @default(now())
}
model InvoiceSequence {
 serie String @id
 lastNumber Int @default(0)
}
model Invoice {
 id String @id @default(uuid()) @db.Uuid
 requestKey String @unique @db.Uuid
 saleId String? @db.Uuid
 sale Sale? @relation(fields:[saleId], references:[id])
 relatedInvoiceId String? @db.Uuid
 relatedInvoice Invoice? @relation("InvoiceRelation", fields:[relatedInvoiceId], references:[id], onDelete: Restrict)
 relatedDocuments Invoice[] @relation("InvoiceRelation")
 type InvoiceType
 serie String
 number Int
 customerDocumentType String
 customerDocument String
 customerName String
 customerAddress String?
 igvType IgvType @default(GRAVADO)
 subtotal Decimal @db.Decimal(12,2)
 igv Decimal @db.Decimal(12,2)
 total Decimal @db.Decimal(12,2)
 creditNoteCode String?
 creditNoteReason String?
 guideReasonCode String?
 guideTransferStartDate DateTime?
 guideGrossWeight Decimal? @db.Decimal(10,2)
 guidePackages Int?
 guideStartAddress String?
 guideEndAddress String?
 guideCarrierDoc String?
 guideCarrierName String?
 guidePlate String?
 status SunatStatus @default(PENDING)
 sunatAccepted Boolean @default(false)
 sunatDescription String?
 sunatNote String?
 sunatResponseCode String?
 sunatSoapError String?
 hashCode String?
 qrString String?
 pdfUrl String?
 xmlUrl String?
 cdrUrl String?
 providerPayload Json?
 providerResponse Json?
 sentAt DateTime?
 requestFingerprint String?
 cancelSaleOnAcceptance Boolean @default(false)
 syncLockToken String? @db.Uuid
 syncLockedUntil DateTime?
 lastSyncedAt DateTime?
 lastSyncError String?
 voided Boolean @default(false)
 createdBy String @db.Uuid
 createdAt DateTime @default(now())
 @@unique([serie, number])
 @@index([saleId])
 @@index([status, createdAt])
 @@index([createdAt])
}
model AuditLog {
 id String @id @default(uuid()) @db.Uuid
 actorId String @db.Uuid
 action String
 entityId String
 createdAt DateTime @default(now())
}
